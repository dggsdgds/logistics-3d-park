# Local-only configuration template.
# Copy this file to .env and replace placeholders if you add server-side
# integrations. Never commit the real .env file.

# Local static server port.
PORT=5178

# Optional server-side LLM key. Keep this on the server only; never put it
# in index.html or any browser-side JavaScript.
# DEEPSEEK_API_KEY=YOUR_API_KEY

# Optional Supabase project URL and public anon key.
# The anon key is designed to be public, but access must still be protected
# by Supabase Row Level Security policies.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=YOUR_ANON_KEY

# NEVER put a Supabase service_role key in this file, the repository,
# browser code, or any public build. Service-role keys bypass Row Level
# Security and must exist only in a private server-side environment.
